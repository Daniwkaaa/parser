# Скопіюйте у .env та змініть за потреби

# База даних. SQLite за замовчуванням; для PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/leadfinder
DATABASE_URL=sqlite:///./data/leadfinder.db

# Ідентифікація клієнта для OSM-сервісів (вимога їхніх правил використання).
# Вкажіть контакт (сайт або email), щоб адміністратори могли з вами зв'язатися.
APP_USER_AGENT=LeadFinder/1.0 (+https://github.com/Daniwkaaa/parser)
CONTACT_EMAIL=

# Overpass: основний сервер і резервні через кому
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Ключі (необов'язково, можна задати й у налаштуваннях інтерфейсу)
GOOGLE_PLACES_API_KEY=
SERPAPI_API_KEY=

# Мережа
HTTP_TIMEOUT=15
WEBSITE_CHECK_CONCURRENCY=4
RESPECT_ROBOTS_TXT=true

LOG_LEVEL=INFO
